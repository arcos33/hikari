[Unit]
Description=Hikari Video Kiosk
After=systemd-user-sessions.service network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin/hikari-video-kiosk
Environment=HOME=/home/admin
EnvironmentFile=-/home/admin/hikari-video-kiosk/kiosk.env
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
ExecStartPre=/home/admin/hikari-video-kiosk/scripts/build-playlist.sh
ExecStart=/home/admin/hikari-video-kiosk/scripts/run-kiosk.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

